# --- Aros API (HTTP Basic Auth) --------------------------------------------
AROS_API_BASE=https://api.aros.uz
AROS_LOGIN=
AROS_PASSWORD=
AROS_PAGE_SIZE=200
AROS_RATE_LIMIT=0.3
HTTP_TIMEOUT=60
HTTP_RETRY=3

# --- n8n webhook'lar (filial plan/bajarildi; auth talab qilmaydi) ----------
N8N_BASE=https://n8n.arosmarket.com/webhook

# --- PostgreSQL (IXTIYORIY) -------------------------------------------------
# Berilsa, filial plan/bajarildi cache_filial dan o'qiladi (n8n o'rniga).
# psycopg2-binary kerak.
# PG_DSN=postgresql://user:parol@host:5432/n8n

# --- Algoritm sozlamalari ---------------------------------------------------
WINDOW_DAYS=5        # yarim oxiridagi necha kun tekshiriladi
HISTORY_DAYS=0       # mijoz o'rtachasi uchun tarix (kun). 0 = oy boshidan
# Ball shkalasi: 0..100 (maksimal ball 100)
BALL_YUQORI=50       # 🔴 YUQORI chegarasi (maksimalning yarmi)
BALL_ORTA=33         # 🟡 O'RTA chegarasi (uchdan biri)
MIN_HALF_PLAN=1000000  # yarim plani shundan kichik filiallar tekshirilmaydi

# 3-varaq "Oxirgi N kun yirik" (1-varaq mantiqidan mustaqil)
YIRIK_SUMMA=2000000  # varaqqa tushish uchun minimal order summasi
OXIRGI_KUN_SONI=4    # yarim oxiridan necha kun (Y1 -> 12,13,14,15)

# Ball profili: kalibr (default, shovqini kam) yoki brief (BRIEF ballari aynan)
PROFIL=kalibr
MIN_DELTA_FOIZ=1.0   # chegara signali uchun orderning minimal o'z hissasi (%)
NASIYA_BALL=15       # wallet uchun ball (kalibr profilida)
